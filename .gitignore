.env
.env.local
.env.production
.env.development
cms/.env
cms/.env.local
cms/.env.production

# Build output
dist/
build/

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Markdown files (Ignore all development/internal docs, keep only README.md at the root)
**/*.md
!/README.md

# Uploaded media and icons
cms/public/uploads/

# Cadangan database — berisi hash password pengguna dan isi pesan masuk.
# JANGAN pernah di-commit.
cms/backups/

